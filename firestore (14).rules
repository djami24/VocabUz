rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin emaillarini tekshirish ──
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'admin@vocabuz.com',
        'djaami2022@gmail.com'
      ];
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Premium bilan bog'liq maydonlar: faqat admin o'zgartira oladi ──
    function premiumFields() {
      return ['isPremium', 'premiumActivatedAt', 'premiumRevokedAt', 'refBonusUntil', 'refCount'];
    }

    // ── Taklif (referral): bonusni faqat referrals/{yangiUid} hujjati BIR MARTA yaratilganda berish mumkin ──
    function refPath() {
      return /databases/$(database)/documents/referrals/$(request.auth.uid);
    }
    function refClaim() {
      return existsAfter(refPath()) && !exists(refPath());
    }

    // ── So'zlar ──
    match /words/{id} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }

    // ── Mavzular ──
    match /topics/{id} {
      allow read:   if isLoggedIn();
      allow write:  if isAdmin();
    }

    // ── Foydalanuvchi profili ──
    match /users/{userId} {
      allow read:  if isLoggedIn() || isAdmin();
      // Talaba o'z hujjatini yaratishi va yangilashi mumkin, LEKIN premium maydonlariga tegmasligi shart.
      // Admin hamma narsani (jumladan isPremium ni) o'zgartira oladi.
      allow create: if isAdmin()
                    || (request.auth.uid == userId
                        && !request.resource.data.keys().hasAny(premiumFields()));
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(premiumFields()))
                    // yangi talaba o'ziga taklif bonusini oladi (3 kun)
                    || (request.auth.uid == userId && refClaim()
                        && !('referredBy' in resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referredBy', 'refBonusUntil'])
                        && request.resource.data.refBonusUntil <= request.time + duration.value(3, 'd') + duration.value(1, 'h'))
                    // taklif qilgan talabaga bonus (+1 taklif, jami 60 kundan oshmaydi)
                    || (request.auth.uid != userId && refClaim()
                        && getAfter(refPath()).data.referrerUid == userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refBonusUntil', 'refCount'])
                        && request.resource.data.refCount == resource.data.get('refCount', 0) + 1
                        && request.resource.data.refBonusUntil <= request.time + duration.value(60, 'd'));
      allow delete: if isAdmin();

      // ── Bildirishnomalar (subcollection) ──
      match /notifications/{notifId} {
        allow read:   if request.auth.uid == userId;
        allow write:  if isAdmin(); // Admin creates notifications
        allow update: if request.auth.uid == userId; // Student can mark as read
      }
    }

    // ── Kirish tarixi ──
    match /visits/{docId} {
      allow create: if isLoggedIn();
      allow read:   if isAdmin();
      allow update,
            delete: if false;
    }

    // ── Konfiguratsiya (mavzu tartibi va boshqa sozlamalar) ──
    match /config/{docId} {
      allow read:  if isLoggedIn();   // barcha login qilganlar o'qiy oladi
      allow write: if isAdmin();      // faqat admin yoza oladi
    }

    // ── Taklif yozuvlari (har bir yangi talaba uchun faqat bitta, o'zgartirib bo'lmaydi) ──
    match /referrals/{inviteeUid} {
      allow create: if isLoggedIn() && request.auth.uid == inviteeUid
                    && request.resource.data.keys().hasOnly(['referrerUid', 'code', 'createdAt'])
                    && request.resource.data.referrerUid != request.auth.uid;
      allow read:   if isAdmin() || request.auth.uid == inviteeUid
                    || (isLoggedIn() && resource.data.referrerUid == request.auth.uid);
      allow update, delete: if false;
    }

    // ── Kunlik statistika: qaysi bo'lim necha marta ochilgan ──
    match /stats/{day} {
      allow read:   if isAdmin();
      allow create, update: if isLoggedIn() && request.resource.data.keys().hasOnly(['sections']);
      allow delete: if false;
    }

    // ── To'lovlar ──
    match /payments/{paymentId} {
      // Students can create and read their own payments
      allow create: if isLoggedIn();
      allow read:   if isLoggedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Only admin can update payment status
      allow update: if isAdmin();
      allow delete: if false;
    }

  }
}
